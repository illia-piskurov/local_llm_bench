{
  "profiles": {
    "lmstudio": {
      "baseUrl": "http://127.0.0.1:1234/v1",
      "apiKeyEnv": "LM_STUDIO_API_KEY"
    },
    "ollama": {
      "baseUrl": "http://127.0.0.1:11434/v1"
    },
    "vllm": {
      "baseUrl": "http://127.0.0.1:8000/v1",
      "apiKeyEnv": "VLLM_API_KEY"
    }
  },
  "defaults": {
    "profile": "lmstudio",
    "temperature": 0.2,
    "maxTokens": 2048,
    "timeoutMs": 120000,
    "runsDir": "runs"
  }
}
